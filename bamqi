    if getgenv().ComboEnabled then
        Button.Text = "Combo: ON"
        Button.BackgroundColor3 = Color3.fromRGB(40,170,40)
    else
        Button.Text = "Combo: OFF"
        Button.BackgroundColor3 = Color3.fromRGB(170,40,40)
    end
end)
